[Unit]
Description=Horarios Académicos - Backend FastAPI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/horarios/backend

# Variables de entorno
Environment="PATH=/var/www/horarios/backend/venv/bin"
Environment="REACT_APP_BACKEND_URL=http://localhost"
Environment="FRONTEND_URL=http://localhost"
Environment="PYTHONPATH=/var/www/horarios/backend"
Environment="PORT=8001"

# Comando Uvicorn optimizado para producción (puerto 8001)
ExecStart=/var/www/horarios/backend/venv/bin/uvicorn server:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 2 \
    --loop uvloop \
    --http h11 \
    --proxy-headers \
    --forwarded-allow-ips='127.0.0.1' \
    --access-log \
    --error-log

# Reinicio automático
Restart=always
RestartSec=3

# Límites de recursos
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
